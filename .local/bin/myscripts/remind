#!/usr/bin/env python3

"""Command-line client for the Quickshell calendar reminder service."""

import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo


IST = ZoneInfo("Asia/Kolkata")
CONFIG_DIR = Path(
    os.environ.get(
        "REMIND_QUICKSHELL_PATH",
        Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "quickshell",
    )
)
REMINDER_ID = re.compile(r"r_\d+(?:_\d+)?")


class RemindError(Exception):
    """An error that can be shown directly to the user."""


def print_usage() -> None:
    print(
        "Usage:\n"
        "  remind [--urgent] <time> <title> [description]\n"
        "  remind list\n"
        "  remind cancel <id>\n"
        "\n"
        "Quote times that contain spaces. Examples:\n"
        '  remind 10m "Take a break"\n'
        '  remind --urgent "in 2 hours" "Leave for the airport"\n'
        '  remind "tomorrow 3pm" "Call Mum" "Ask about the appointment"\n'
        '  remind "2026-09-26 18:30" "Pay electricity"'
    )


def parse_clock(value: str) -> tuple[int, int, int]:
    match = re.fullmatch(
        r"(\d{1,2})(?::(\d{2}))?(?::(\d{2}))?\s*(am|pm)?",
        value.strip(),
        re.IGNORECASE,
    )
    if not match:
        raise ValueError("expected a time such as 14:30 or 2:30pm")
    hour = int(match.group(1))
    minute = int(match.group(2) or 0)
    second = int(match.group(3) or 0)
    meridiem = (match.group(4) or "").lower()
    if minute > 59 or second > 59:
        raise ValueError("minute and second must be between 00 and 59")
    if meridiem:
        if not 1 <= hour <= 12:
            raise ValueError("12-hour times need an hour from 1 to 12")
        hour = hour % 12 + (12 if meridiem == "pm" else 0)
    elif hour > 23:
        raise ValueError("hour must be between 0 and 23")
    return hour, minute, second


def parse_time(value: str, now: datetime | None = None) -> datetime:
    now = now or datetime.now(IST)
    value = value.strip()

    shorthand = re.fullmatch(r"(\d+)([smhd])", value, re.IGNORECASE)
    if shorthand:
        amount = int(shorthand.group(1))
        unit = shorthand.group(2).lower()
        names = {"s": "seconds", "m": "minutes", "h": "hours", "d": "days"}
        return now + timedelta(**{names[unit]: amount})

    relative = re.fullmatch(
        r"in\s+(\d+)\s+(seconds?|minutes?|hours?|days?)",
        value,
        re.IGNORECASE,
    )
    if relative:
        amount = int(relative.group(1))
        unit = relative.group(2).lower().rstrip("s") + "s"
        return now + timedelta(**{unit: amount})

    if value.lower() == "tomorrow":
        return now + timedelta(days=1)

    tomorrow = re.fullmatch(r"tomorrow\s+(.+)|(.+?)\s+tomorrow", value, re.IGNORECASE)
    if tomorrow:
        clock = tomorrow.group(1) or tomorrow.group(2)
        hour, minute, second = parse_clock(clock)
        target = now.date() + timedelta(days=1)
        return datetime(target.year, target.month, target.day, hour, minute, second, tzinfo=IST)

    dated = re.fullmatch(r"(\d{4}-\d{2}-\d{2})(?:[ T](.+))?", value)
    if dated:
        try:
            target = datetime.strptime(dated.group(1), "%Y-%m-%d").date()
        except ValueError as error:
            raise ValueError("invalid calendar date") from error
        if not dated.group(2):
            return datetime(target.year, target.month, target.day, tzinfo=IST)
        clock = dated.group(2)
        try:
            parsed = datetime.fromisoformat(f"{dated.group(1)}T{clock.replace('Z', '+00:00')}")
        except ValueError:
            hour, minute, second = parse_clock(clock)
            parsed = datetime(target.year, target.month, target.day, hour, minute, second)
        return parsed.replace(tzinfo=IST) if parsed.tzinfo is None else parsed.astimezone(IST)

    hour, minute, second = parse_clock(value)
    return now.replace(hour=hour, minute=minute, second=second, microsecond=0)


def parse_set_arguments(arguments: list[str], now: datetime | None = None) -> dict:
    urgent = False
    positional = []
    for argument in arguments:
        if argument in {"-u", "--urgent"}:
            urgent = True
        else:
            positional.append(argument)
    if len(positional) < 2:
        raise RemindError("A time and title are required.")

    when_text, title = positional[:2]
    description = " ".join(positional[2:]).strip()
    if not title.strip():
        raise RemindError("Title cannot be empty.")
    if len(title) > 200:
        raise RemindError("Title must be at most 200 characters.")
    if len(description) > 1000:
        raise RemindError("Description must be at most 1000 characters.")
    now = now or datetime.now(IST)
    try:
        trigger_at = parse_time(when_text, now)
    except (OverflowError, ValueError) as error:
        raise RemindError(f"Could not parse time {when_text!r}: {error}") from error
    if trigger_at <= now:
        raise RemindError(f"That time has already passed ({trigger_at:%Y-%m-%d %H:%M:%S %Z}).")
    return {
        "title": title.strip(),
        "description": description,
        "at": trigger_at.isoformat(timespec="seconds"),
        "urgent": urgent,
    }


def parse_command_line(value: str, now: datetime | None = None) -> dict:
    try:
        arguments = shlex.split(value)
    except ValueError as error:
        raise RemindError(f"Could not read command: {error}") from error
    if arguments and arguments[0] == "remind":
        arguments = arguments[1:]
    return parse_set_arguments(arguments, now)


def call_quickshell(function: str, *arguments: str) -> str:
    executable = shutil.which("qs")
    if not executable:
        raise RemindError("Quickshell CLI 'qs' was not found in PATH.")
    try:
        result = subprocess.run(
            [executable, "-p", str(CONFIG_DIR), "ipc", "call", "reminders", function, *arguments],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        raise RemindError("Quickshell did not answer within 10 seconds.") from error
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "unknown IPC error"
        raise RemindError(f"Could not contact the Quickshell reminder service: {detail}")
    return result.stdout.strip()


def command_set(arguments: list[str]) -> None:
    reminder = parse_set_arguments(arguments)

    reminder_id = call_quickshell(
        "add",
        reminder["title"],
        reminder["at"],
        "true" if reminder["urgent"] else "false",
        reminder["description"],
    )
    if not reminder_id:
        raise RemindError("The calendar rejected the reminder. Open it to see the validation error.")
    trigger_at = datetime.fromisoformat(reminder["at"])
    print(f"Reminder set: {reminder['title']}")
    print(f"  ID: {reminder_id}")
    print(f"  At: {trigger_at:%Y-%m-%d %H:%M:%S %Z}")


def command_list() -> None:
    raw = call_quickshell("list")
    try:
        reminders = json.loads(raw)
    except json.JSONDecodeError as error:
        raise RemindError("Quickshell returned an invalid reminder list.") from error
    if not isinstance(reminders, list):
        raise RemindError("Quickshell returned an invalid reminder list.")
    if not reminders:
        print("No active reminders.")
        return
    for reminder in reminders:
        try:
            when = datetime.fromisoformat(reminder["at"]).astimezone(IST)
            reminder_id = reminder["id"]
            title = reminder["title"]
        except (KeyError, TypeError, ValueError) as error:
            raise RemindError("Quickshell returned a malformed reminder.") from error
        description = reminder.get("description", "")
        urgent = "  [urgent]" if reminder.get("urgent") is True else ""
        suffix = f" - {description}" if description else ""
        print(f"  {reminder_id}  {when:%Y-%m-%d %H:%M:%S}  {title}{urgent}{suffix}")


def command_cancel(arguments: list[str]) -> None:
    if len(arguments) != 1 or not REMINDER_ID.fullmatch(arguments[0]):
        raise RemindError("Usage: remind cancel <id>")
    reminder_id = arguments[0]
    if call_quickshell("cancel", reminder_id) != "true":
        raise RemindError(f"No active reminder found with id: {reminder_id}")
    print(f"Cancelled: {reminder_id}")


def main(arguments: list[str]) -> int:
    if not arguments or arguments[0] in {"-h", "--help", "help"}:
        print_usage()
        return 0 if arguments else 1
    try:
        if arguments[0] == "parse":
            if len(arguments) != 2:
                raise RemindError("Usage: remind parse '<reminder command>'")
            print(json.dumps(parse_command_line(arguments[1]), separators=(",", ":")))
        elif arguments[0] == "list":
            if len(arguments) != 1:
                raise RemindError("Usage: remind list")
            command_list()
        elif arguments[0] == "cancel":
            command_cancel(arguments[1:])
        else:
            command_set(arguments)
    except RemindError as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
