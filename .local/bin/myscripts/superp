#!/bin/sh

# if [ ! -t 2 ]; then
#     exec alacritty --class foot-prg-superp -e "$0" "$@"
# fi

HOME_DIR=${HOME}
# Space-separated search roots. Override with e.g.:
#   SUPERP_SEARCH_ROOTS=". $HOME" superp
SUPERP_SEARCH_ROOTS=${SUPERP_SEARCH_ROOTS:-$HOME_DIR}

# shellcheck disable=SC2086 # intentional: SUPERP_SEARCH_ROOTS is space-separated config
set -- $SUPERP_SEARCH_ROOTS

selected_row=$(
    fd -t f \
        -E 'game' -E 'lib' -E 'renpy' \
        -E 'Games*' \
        -E 'Backups' \
        -E 'GitClones*' \
        . "$@" |
        awk -v home="$HOME_DIR" '
            BEGIN { OFS = "\t" }
            {
                path = $0
                file = path
                sub(/^.*\//, "", file)

                dir = path
                if (dir == file) {
                    dir = "."
                } else {
                    sub(/\/[^/]*$/, "", dir)
                    if (dir == "") dir = "/"
                }

                display_dir = dir
                if (display_dir == home) {
                    display_dir = "~"
                } else if (index(display_dir, home "/") == 1) {
                    display_dir = "~" substr(display_dir, length(home) + 1)
                }

                print path, file, display_dir
            }
        ' |
        fuzzel \
            --dmenu \
            --prompt "Open file> " \
            --with-nth '{2}  {3}' \
            --match-nth '{2} {3}' \
            --accept-nth 1
    # sk \
    #     --reverse \
    #     --algo clangd \
    #     -p "Open file> " \
    #     --delimiter '\t' \
    #     --nth '2,3' \
    #     --with-nth '2,3'
)

if [ -n "$selected_row" ]; then
    selected_path=$(printf '%s\n' "$selected_row" | awk -F '\t' 'NR == 1 { print $1 }')
    if [ -n "$selected_path" ]; then
        setsid -f xdg-open "$selected_path" >/dev/null 2>&1
    fi
fi
