{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "playwright_browser_run_code_unsafe",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "worktree": {
    "directory": ".worktrees/"
  },
  "mcp": {
    "servers": {
      "ddg-search": {
        "command": [
          "uvx",
          "duckduckgo-mcp-server"
        ],
        "type": "local",
        "environment": {
          "DDG_SAFE_SEARCH": "STRICT"
        }
      },
      "codebase-memory-mcp": {
        "type": "local",
        "command": [
          "/home/shubham/.local/bin/codebase-memory-mcp"
        ]
      },
      "ketch": {
        "type": "local",
        "command": [
          "ketch",
          "mcp",
          "serve"
        ]
      },
      "context7": {
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ],
        "type": "local",
        "environment": {
          "NPM_CONFIG_USERCONFIG": "{env:HOME}/.config/npm/npmrc"
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.80",
          "--executable-path",
          "{env:HOME}/.local/bin/chromium"
        ]
      }
    }
  },
  "lsp": {}
}
