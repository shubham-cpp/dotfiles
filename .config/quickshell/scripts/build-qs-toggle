#!/bin/sh
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mkdir -p "$base/.local/bin"
cc -std=c11 -O2 -Wall -Wextra -Werror -fstack-protector-strong \
    -D_FORTIFY_SOURCE=3 -Wl,-z,relro,-z,now \
    "$base/scripts/qs-toggle.c" -o "$base/.local/bin/qs-toggle.new"
chmod 700 "$base/.local/bin/qs-toggle.new"
mv "$base/.local/bin/qs-toggle.new" "$base/.local/bin/qs-toggle"
