#!/bin/sh
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mkdir -p "$base/.local/bin"
cc -std=c11 -O2 -Wall -Wextra -Werror -fstack-protector-strong \
    -D_FORTIFY_SOURCE=3 -Wl,-z,relro,-z,now \
    "$base/scripts/lock-auth.c" -lpam -o "$base/.local/bin/lock-auth.new"
chmod 700 "$base/.local/bin/lock-auth.new"
mv "$base/.local/bin/lock-auth.new" "$base/.local/bin/lock-auth"
