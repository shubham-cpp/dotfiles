configuration {
    modi:                "drun,run,filebrowser,window";
    show-icons:          true;
    display-drun:        "Apps";
    display-run:         "Run";
    display-filebrowser: "Files";
    display-window:      "Windows";
    display-clipboard:   "󰆏";
    drun-display-format: "{name}";
    window-format:       "{w} · {c} · {t}";
    matching:            "regex";
    sorting-method:      "fzf";
    sort:                true;
    kb-accept-entry:     "Control+m,Return,KP_Enter";
    kb-row-up:           "Control+k,Up";
    kb-row-down:         "Control+j,Down";
    kb-remove-to-eol:    "Control+i";
}

* {
    font:              "Fira Sans 12";

    /* Raycast Obsidian: macOS command-palette glass translated to rofi. */
    bg0:               rgba(8, 8, 10, 0.94);
    bg1:               rgba(255, 255, 255, 0.07);
    bg2:               rgba(255, 255, 255, 0.11);
    bg3:               rgba(255, 255, 255, 0.045);
    glow:              rgba(255, 99, 99, 0.18);

    fg0:               rgba(246, 246, 247, 0.78);
    fg1:               rgba(255, 255, 255, 0.96);
    fg2:               rgba(246, 246, 247, 0.42);

    accent:            #ff6363;
    accent-soft:       rgba(255, 99, 99, 0.14);
    urgent:            #ff5d5d;
    active:            #63f2b6;
    border-col:        rgba(255, 255, 255, 0.16);

    background-color:  transparent;
    text-color:        @fg0;
    margin:            0;
    padding:           0;
    spacing:           0;
}

/*****----- Main Window -----*****/
window {
    transparency:      "real";
    background-color:  @bg0;
    background-image:  linear-gradient(to bottom, rgba(35, 35, 42, 0.96), rgba(7, 7, 10, 0.94));
    location:          center;
    anchor:            center;
    width:             760px;
    border:            1px solid;
    border-color:      @border-col;
    border-radius:     20px;
    cursor:            "default";
}

/*****----- Main Box -----*****/
mainbox {
    background-color:  transparent;
    children:          [ "inputbar", "listview", "message", "mode-switcher" ];
    spacing:           0;
    padding:           0;
}

/*****----- Inputbar -----*****/
inputbar {
    padding:           18px 20px 16px 20px;
    spacing:           12px;
    background-color:  rgba(255, 255, 255, 0.025);
    border:            0 0 1px 0;
    border-color:      @bg1;
    text-color:        @fg1;
    children:          [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand:            false;
    str:               " ";
    font:              "JetBrainsMono Nerd Font 14";
    text-color:        @fg2;
    padding:           0px 0 0 0;
    vertical-align:    0.5;
    background-color:  transparent;
}

entry {
    font:              "Fira Sans SemiBold 17";
    placeholder:       "Search for apps and commands...";
    placeholder-color: @fg2;
    text-color:        @fg1;
    padding:           1px 0;
    background-color:  transparent;
    cursor:            text;
    vertical-align:    0.5;
}

/*****----- Listview -----*****/
listview {
    columns:           1;
    lines:             8;
    cycle:             true;
    dynamic:           true;
    scrollbar:         false;
    layout:            vertical;
    fixed-height:      true;
    spacing:           5px;
    padding:           10px 12px 12px 12px;
    background-color:  transparent;
    cursor:            "default";
}

/*****----- Elements -----*****/
element {
    spacing:           12px;
    padding:           10px 12px;
    border:            1px solid;
    border-radius:     12px;
    border-color:      transparent;
    background-color:  transparent;
    text-color:        @fg0;
    cursor:            pointer;
}

element normal.normal {
    background-color:  transparent;
    border-color:      transparent;
    text-color:        @fg0;
}

element normal.urgent {
    background-color:  transparent;
    border-color:      transparent;
    text-color:        @urgent;
}

element normal.active {
    background-color:  transparent;
    border-color:      transparent;
    text-color:        @active;
}

element selected.normal {
    background-color:  @bg2;
    background-image:  linear-gradient(to right, rgba(255, 99, 99, 0.16), rgba(255, 255, 255, 0.08));
    border-color:      rgba(255, 255, 255, 0.12);
    text-color:        @fg1;
}

element selected.urgent {
    background-color:  rgba(255, 93, 93, 0.18);
    border-color:      rgba(255, 93, 93, 0.28);
    text-color:        @fg1;
}

element selected.active {
    background-color:  rgba(99, 242, 182, 0.15);
    border-color:      rgba(99, 242, 182, 0.24);
    text-color:        @fg1;
}

element alternate.normal {
    background-color:  transparent;
    border-color:      transparent;
    text-color:        @fg0;
}

element alternate.urgent {
    background-color:  transparent;
    border-color:      transparent;
    text-color:        @urgent;
}

element alternate.active {
    background-color:  transparent;
    border-color:      transparent;
    text-color:        @active;
}

element-icon {
    size:              28px;
    background-color:  transparent;
    text-color:        inherit;
    vertical-align:    0.5;
    cursor:            inherit;
}

element-text {
    font:              "Fira Sans Medium 13";
    background-color:  transparent;
    text-color:        inherit;
    vertical-align:    0.5;
    horizontal-align:  0.0;
    highlight:         bold #ffffff;
    cursor:            inherit;
}

/*****----- Message -----*****/
message {
    padding:           0;
    border:            1px 0 0 0;
    border-color:      @bg1;
    background-color:  transparent;
    text-color:        @fg2;
    font:              "Fira Sans 11";
}

textbox {
    padding:           10px 20px;
    background-color:  transparent;
    vertical-align:    0.5;
    horizontal-align:  0.0;
    highlight:         none;
    markup:            true;
}

error-message {
    padding:           14px;
    border:            1px solid;
    border-radius:     12px;
    border-color:      rgba(255, 93, 93, 0.32);
    background-color:  @bg0;
    text-color:        @urgent;
}

/*****----- Mode Switcher / Raycast-style footer -----*****/
mode-switcher {
    spacing:           8px;
    padding:           9px 12px;
    background-color:  @bg3;
    border:            1px 0 0 0;
    border-color:      @bg1;
}

button {
    padding:           5px 11px;
    border:            1px solid;
    border-radius:     8px;
    border-color:      rgba(255, 255, 255, 0.06);
    background-color:  rgba(255, 255, 255, 0.045);
    text-color:        @fg2;
    cursor:            pointer;
    font:              "Fira Sans Medium 11";
}

button selected {
    background-color:  @accent-soft;
    border-color:      rgba(255, 99, 99, 0.26);
    text-color:        @fg1;
}
